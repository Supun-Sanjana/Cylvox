{
  "name": "Core Web Vitals Daily Monitor (Cylvox)",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "days", "daysInterval": 1, "triggerAtHour": 5}]}},
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-660, 0]
    },
    {
      "parameters": {
        "jsMode": "runOnceForAllItems",
        "jsCode": "// Add every page you want monitored.\nconst pages = [\n  'https://REPLACE_WITH_YOUR_DOMAIN.com/',\n  'https://REPLACE_WITH_YOUR_DOMAIN.com/REPLACE_WITH_KEY_PAGE'\n];\nreturn pages.map(url => ({ json: { url } }));"
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "Define Pages to Monitor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-440, 0]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/pagespeedonline/v5/runPagespeed",
        "sendQuery": true,
        "queryParameters": {"parameters": [
          {"name": "url", "value": "={{ $json.url }}"},
          {"name": "strategy", "value": "mobile"},
          {"name": "key", "value": "REPLACE_WITH_YOUR_PAGESPEED_API_KEY"}
        ]},
        "options": {"batching": {"batch": {"batchSize": 1, "batchInterval": 3000}}, "timeout": 30000}
      },
      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "Run PageSpeed Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "jsMode": "runOnceForEachItem",
        "jsCode": "const d = item.json;\nconst lr = d.lighthouseResult;\nconst audits = lr?.audits || {};\nreturn { json: {\n  url: d.id,\n  performanceScore: Math.round((lr?.categories?.performance?.score || 0) * 100),\n  lcp: audits['largest-contentful-paint']?.displayValue || 'N/A',\n  cls: audits['cumulative-layout-shift']?.displayValue || 'N/A',\n  inp: audits['interaction-to-next-paint']?.displayValue || audits['total-blocking-time']?.displayValue || 'N/A',\n  checkedAt: new Date().toISOString()\n} };"
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "Extract CWV Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID"},
        "sheetName": {"__rl": true, "mode": "name", "value": "CWV Log"},
        "columns": {"mappingMode": "autoMapInputData"},
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000005",
      "name": "Log CWV Results",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0],
      "credentials": {"googleSheetsOAuth2Api": {"id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets account"}}
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [{"id": "c1", "leftValue": "={{ $json.performanceScore }}", "rightValue": 90, "operator": {"type": "number", "operation": "lt"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000006",
      "name": "Score Below 90?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_YOUR_SLACK_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🐢 CWV Alert: {{ $json.url }} scored {{ $json.performanceScore }}/100 (mobile)\\nLCP: {{ $json.lcp }} | CLS: {{ $json.cls }} | INP: {{ $json.inp }}\"\n}",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000007",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {},
      "id": "e1000000-0000-4000-8000-000000000008",
      "name": "OK - No Action",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 100]
    }
  ],
  "connections": {
    "Daily Schedule": {"main": [[{"node": "Define Pages to Monitor", "type": "main", "index": 0}]]},
    "Define Pages to Monitor": {"main": [[{"node": "Run PageSpeed Insights", "type": "main", "index": 0}]]},
    "Run PageSpeed Insights": {"main": [[{"node": "Extract CWV Metrics", "type": "main", "index": 0}]]},
    "Extract CWV Metrics": {"main": [[{"node": "Log CWV Results", "type": "main", "index": 0}]]},
    "Log CWV Results": {"main": [[{"node": "Score Below 90?", "type": "main", "index": 0}]]},
    "Score Below 90?": {"main": [[{"node": "Send Slack Alert", "type": "main", "index": 0}], [{"node": "OK - No Action", "type": "main", "index": 0}]]}
  },
  "pinData": {},
  "meta": {"templateCredsSetupCompleted": false}
}
