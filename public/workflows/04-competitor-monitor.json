{
  "name": "Competitor SEO & Price Monitor (Cylvox)",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "days", "daysInterval": 1, "triggerAtHour": 7}]}},
      "id": "d1000000-0000-4000-8000-000000000001",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-660, 0]
    },
    {
      "parameters": {
        "jsMode": "runOnceForAllItems",
        "jsCode": "// Add one line per competitor page you want to track.\n// selector fields are simple regex hints used below - adjust per site structure.\nconst competitors = [\n  { name: 'Competitor A', url: 'https://REPLACE_WITH_COMPETITOR_URL_1.com' },\n  { name: 'Competitor B', url: 'https://REPLACE_WITH_COMPETITOR_URL_2.com' }\n];\nreturn competitors.map(c => ({ json: c }));"
      },
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "Define Competitor URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-440, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {"response": {"response": {"responseFormat": "text"}}, "batching": {"batch": {"batchSize": 3, "batchInterval": 2000}}}
      },
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "Fetch Competitor Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "jsMode": "runOnceForEachItem",
        "jsCode": "const html = item.json.data || item.json.body || '';\nconst titleMatch = html.match(/<title[^>]*>(.*?)<\\/title>/is);\nconst title = titleMatch ? titleMatch[1].trim() : 'Not found';\n\n// Generic price pattern - matches $12.99, $12, USD 12.99 etc. Adjust per site structure if needed.\nconst priceMatch = html.match(/(?:\\$|USD)\\s?(\\d{1,5}(?:[.,]\\d{2})?)/);\nconst price = priceMatch ? priceMatch[0] : 'Not found';\n\nconst metaDescMatch = html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"'](.*?)[\"']/is);\nconst metaDescription = metaDescMatch ? metaDescMatch[1].trim() : 'Not found';\n\nreturn { json: { competitor: item.json.name, url: item.json.url, title, price, metaDescription, checkedAt: new Date().toISOString() } };"
      },
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "Extract Title Price Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID"},
        "sheetName": {"__rl": true, "mode": "name", "value": "Tracking"},
        "columns": {"mappingMode": "autoMapInputData"},
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Append to Tracking Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0],
      "credentials": {"googleSheetsOAuth2Api": {"id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets account"}}
    },
    {
      "parameters": {"aggregate": "aggregateAllItemData", "options": {}},
      "id": "d1000000-0000-4000-8000-000000000006",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_YOUR_SLACK_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"📊 Competitor Digest ({{ $now.toFormat('yyyy-MM-dd') }}):\\n{{ $json.data.map(d => `• ${d.competitor}: ${d.price} — \\\"${d.title}\\\"`).join('\\n') }}\"\n}",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000007",
      "name": "Send Slack Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Daily Schedule": {"main": [[{"node": "Define Competitor URLs", "type": "main", "index": 0}]]},
    "Define Competitor URLs": {"main": [[{"node": "Fetch Competitor Page", "type": "main", "index": 0}]]},
    "Fetch Competitor Page": {"main": [[{"node": "Extract Title Price Meta", "type": "main", "index": 0}]]},
    "Extract Title Price Meta": {"main": [[{"node": "Append to Tracking Sheet", "type": "main", "index": 0}]]},
    "Append to Tracking Sheet": {"main": [[{"node": "Aggregate Results", "type": "main", "index": 0}]]},
    "Aggregate Results": {"main": [[{"node": "Send Slack Digest", "type": "main", "index": 0}]]}
  },
  "pinData": {},
  "meta": {"templateCredsSetupCompleted": false}
}
